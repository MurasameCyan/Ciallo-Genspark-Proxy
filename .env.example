# Ciallo Genspark Proxy - runtime configuration
# Copy to .env (gitignored) and fill in your own values.

# ---- Dashboard ------------------------------------------------------------
WEB_PORT=8899
PANEL_USER=admin
# Required. Without it the dashboard runs with no login protection.
PANEL_PASS=
# Optional: read the password from a mounted file instead of this variable.
# PANEL_PASS_FILE=/run/secrets/panel_password

# Optional API key for /v1/* clients. Leave empty to delegate auth to an upstream gateway.
API_KEY=
# Set to 1 only behind HTTPS; leave 0 for direct HTTP access.
COOKIE_SECURE=0

# ---- Cloudflare Temp Email ------------------------------------------------
# Worker/API root URL (not a Pages frontend URL).
MAIL_API_BASE=
MAIL_ADMIN_AUTH=
MAIL_AUTH_MODE=x-admin-auth
MAIL_CREATE_PATH=
MAIL_DOMAIN=
# Comma or newline separated. Keep only domains configured on the Worker.
MAIL_DOMAINS=
MAIL_DOMAIN_MODE=round_robin
MAIL_POLL_INTERVAL=2
MAIL_TIMEOUT=240

# ---- Update check ------------------------------------------------------------
# Header hash chip compares the running build with this repo/branch, on click only.
GITHUB_REPO=MurasameCyan/Ciallo-Genspark-Proxy
GITHUB_TRACK_REF=main

# ---- Registration / CAPTCHA ------------------------------------------------
# 1 = orchestrator calls the driver's autocap command when 2captcha is configured.
REGISTER_AUTO_SOLVE=1
# Put your real 2captcha key here; empty keeps CAPTCHA manual.
TWOCAPTCHA_KEY=
TWOCAPTCHA_PROXY=

# ---- Docker ---------------------------------------------------------------
# Image override, defaults to the published GHCR image.
# IMAGE=ghcr.io/murasamecyan/ciallo-genspark-proxy:latest
