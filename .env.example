# Dashboard port
WEB_PORT=8899

# Dashboard session credentials. Set a strong password before exposing the port.
PANEL_USER=admin
PANEL_PASS=change-me-now

# Optional API key for /v1/* clients. Leave empty to delegate auth to an upstream gateway.
API_KEY=

# Cloudflare Temp Email Worker/API root and credentials.
MAIL_API_BASE=
MAIL_ADMIN_AUTH=
MAIL_AUTH_MODE=x-admin-auth
MAIL_CREATE_PATH=
MAIL_DOMAIN=
# Comma or newline separated. Keep only domains configured on the Worker.
MAIL_DOMAINS=
MAIL_DOMAIN_MODE=round_robin
MAIL_POLL_INTERVAL=2
MAIL_TIMEOUT=240

# CAPTCHA automation. Leave the key empty to drive the browser manually.
REGISTER_AUTO_SOLVE=1
TWOCAPTCHA_KEY=
TWOCAPTCHA_PROXY=

# Set to 1 only behind HTTPS; leave 0 for direct HTTP access.
COOKIE_SECURE=0

# Optional image override for compose.
# IMAGE=ghcr.io/your-owner/ciallo-genspark-proxy:latest
